{
  "expo": {
    "name": "Climate Permit",
    "slug": "climate-permit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-permit-v2.png",
    "scheme": "climatepermit",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5efde",
        "foregroundImage": "./assets/images/icon-permit-adaptive-v2.png"
      },
      "package": "app.climatepermit.android",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon-permit-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5efde",
          "dark": {
            "backgroundColor": "#13161d"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8333116290939960~5617693723"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
